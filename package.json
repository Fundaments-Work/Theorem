{
    "name": "theorem",
    "version": "1.6.1",
    "description": "Local-first desktop reader for PDFs, EPUBs, MOBI, and RSS with neural TTS, highlights, vocabulary building, and Markdown export.",
    "private": true,
    "type": "module",
    "author": "Fundamentals",
    "license": "MIT",
    "homepage": "https://github.com/fundaments-work/theorem",
    "repository": {
        "type": "git",
        "url": "https://github.com/fundaments-work/theorem.git"
    },
    "bugs": {
        "url": "https://github.com/fundaments-work/theorem/issues"
    },
    "keywords": [
        "reader",
        "epub",
        "pdf",
        "rss",
        "tauri",
        "ebook",
        "highlights",
        "annotations",
        "text-to-speech",
        "tts",
        "vocabulary",
        "obsidian",
        "logseq",
        "markdown",
        "offline-first",
        "local-first",
        "cross-platform",
        "react",
        "rust"
    ],
    "packageManager": "pnpm@10.18.1",
    "scripts": {
        "dev": "vite",
        "dev:host": "TAURI_DEV_HOST=$(ip route get 1 | awk '{print $7; exit}') vite --host 0.0.0.0",
        "dev:tauri": "tauri dev --features devtools",
        "dev:tauri:no-gpu": "WEBKIT_DISABLE_COMPOSITING_MODE=1 tauri dev --features devtools",
        "dev:tauri:connect": "TAURI_DEV_HOST=$(ip route get 1 | awk '{print $7; exit}') tauri dev --features devtools --config '{\"build\":{\"beforeDevCommand\":\"\"}}'",
        "dev:android": "TAURI_DEV_HOST=$(ip route get 1 | awk '{print $7; exit}') JAVA_HOME=/opt/android-studio/jbr ANDROID_HOME=$HOME/Android/Sdk pnpm tauri android dev --features devtools --config '{\"build\":{\"beforeDevCommand\":\"\"}}'",
        "dev:android:connect": "TAURI_DEV_HOST=$(ip route get 1 | awk '{print $7; exit}') JAVA_HOME=/opt/android-studio/jbr ANDROID_HOME=$HOME/Android/Sdk pnpm tauri android dev --features devtools --config '{\"build\":{\"beforeDevCommand\":\"\"}}'",
        "build": "pnpm run typecheck && vite build && node scripts/verify-pdfjs-assets.mjs && node scripts/check-startup-bundle.mjs",
        "build:wasm": "cargo build --manifest-path src-tauri/Cargo.toml -p theorem-core --target wasm32-unknown-unknown --release",
        "foliate:check": "bash scripts/sync-foliate-js.sh --check",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
        "check:design": "node scripts/check-design-rules.mjs",
        "gates:fast": "pnpm typecheck && pnpm check:design && pnpm test",
        "gates": "(cd src-tauri && cargo fmt --check && cargo clippy --all-features --all-targets -- -D warnings && cargo test --workspace --lib --tests) && pnpm install --frozen-lockfile && pnpm gates:fast && pnpm foliate:check && pnpm build",
        "package:linux": "bash ./scripts/makepackage-linux.sh",
        "package:linux:all": "bash ./scripts/makepackage-linux.sh --bundle all",
        "install:linux": "bash ./scripts/install-linux.sh",
        "uninstall:linux": "bash ./scripts/uninstall-linux.sh",
        "test": "vitest run",
        "test:watch": "vitest",
        "e2e": "node e2e/run.mjs",
        "e2e:build": "node e2e/run.mjs --build",
        "test:coverage": "vitest run --coverage",
        "preview": "vite preview",
        "tauri": "tauri",
        "clean:tauri": "cargo clean --manifest-path src-tauri/Cargo.toml",
        "build:android": "JAVA_HOME=/opt/android-studio/jbr ANDROID_HOME=$HOME/Android/Sdk pnpm tauri android build --debug --features devtools"
    },
    "dependencies": {
        "@radix-ui/react-context-menu": "^2.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@sentry/react": "^11.8.0",
        "@tanstack/react-virtual": "^3.14.21",
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-barcode-scanner": "^2.5.3",
        "@tauri-apps/plugin-dialog": "^2.8.3",
        "@tauri-apps/plugin-fs": "^2.7.1",
        "@tauri-apps/plugin-global-shortcut": "^2.4.1",
        "@tauri-apps/plugin-log": "^2.10.1",
        "@tauri-apps/plugin-notification": "^2.7.0",
        "@tauri-apps/plugin-opener": "^2.7.2",
        "@tauri-apps/plugin-updater": "^2.14.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "dompurify": "^3.4.17",
        "fast-xml-parser": "^5.11.2",
        "fflate": "^0.8.3",
        "html-to-image": "^1.11.13",
        "i18next": "^26.5.2",
        "i18next-browser-languagedetector": "^8.2.1",
        "idb-keyval": "^6.3.0",
        "knap": "^0.6.0",
        "lucide-react": "^1.59.0",
        "pdfjs-dist": "^6.4.299",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "uuid": "^14.0.3",
        "zod": "^4.6.7",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2.12.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.5",
        "fake-indexeddb": "6.0.1",
        "jsdom": "^30.1.3",
        "tailwindcss": "^4.3.3",
        "typescript": "~7.0.2",
        "vite": "^8.3.4",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^5.0.5"
    },
    "pnpm": {
        "overrides": {
            "source-map-js": "1.2.2"
        }
    }
}

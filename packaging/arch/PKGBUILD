# Maintainer: Sabin Pokharel
#
# Installs the prebuilt Linux x86_64 release of Theorem from GitHub (the .deb
# is unpacked; nothing is built). Only an amd64 package is published, so this
# is x86_64 only. Bump pkgver and the checksums together on each release.
pkgname=theorem-bin
_pkgname=theorem
pkgver=1.5.9
pkgrel=1
pkgdesc="Local-first reader for ebooks, PDFs, comics and RSS that writes highlights as Markdown for Obsidian or Logseq (prebuilt)"
arch=('x86_64')
url="https://theorem.fundaments.work"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
optdepends=('speech-dispatcher: read aloud with the system voice')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
options=('!strip' '!debug')
_deb="Theorem_${pkgver}_amd64.deb"
noextract=("${_deb}")
source=("${_deb}::https://github.com/Fundaments-Work/Theorem/releases/download/v${pkgver}/${_deb}"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/Fundaments-Work/Theorem/v${pkgver}/LICENSE")
sha256sums=('38d40a73cc1ece0eeef857c19eb34104c15320abcb6b7f8e43a46c51f23cf8a5'
            '24321bdb7c4db56bce2ba0d9ef724b8fcbec0c02616dbc43ed2479d0c4637cdb')

package() {
  cd "${srcdir}"
  bsdtar -xf "${_deb}" data.tar.gz
  bsdtar -xf data.tar.gz -C "${pkgdir}"
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "opener:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "/media/**"
        },
        {
          "path": "/run/media/**"
        },
        {
          "path": "/mnt/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "/media/**"
        },
        {
          "path": "/run/media/**"
        },
        {
          "path": "/mnt/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "/media/**"
        },
        {
          "path": "/run/media/**"
        },
        {
          "path": "/mnt/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "/media/**"
        },
        {
          "path": "/run/media/**"
        },
        {
          "path": "/mnt/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "/media/**"
        },
        {
          "path": "/run/media/**"
        },
        {
          "path": "/mnt/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "/media/**"
        },
        {
          "path": "/run/media/**"
        },
        {
          "path": "/mnt/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DATA/**"
        },
        {
          "path": "$LOCALDATA/**"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "/media/**"
        },
        {
          "path": "/run/media/**"
        },
        {
          "path": "/mnt/**"
        }
      ]
    },
    "fs:allow-remove",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "log:default",
    "notification:default",
    "window-state:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "updater:default"
  ]
}

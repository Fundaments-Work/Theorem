// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`gallery > matches the shared-component markup snapshot 1`] = `"<div class="mx-auto flex max-w-4xl flex-col gap-6 p-4 sm:p-8"><header class="flex items-center justify-between gap-4"><h1 class="ui-page-title">UI gallery</h1><button type="button" class="ui-btn disabled:opacity-50">Theme: dark</button></header><section class="ui-section p-4 sm:p-6"><h2 class="ui-page-title !text-base">Colour tokens</h2><p class="mt-1 mb-4 text-xs text-[color:var(--color-text-muted)]">Use these through var(--color-...). Never a raw hex.</p><div class="mt-4 flex flex-wrap items-start gap-3"><div class="w-36"><div class="h-10 border border-[var(--color-border)]" style="background: var(--color-background);"></div><code class="mt-1 block break-all text-[10px] text-[color:var(--color-text-muted)]">--color-background</code></div><div class="w-36"><div class="h-10 border border-[var(--color-border)]" style="background: var(--color-surface);"></div><code class="mt-1 block break-all text-[10px] text-[color:var(--color-text-muted)]">--color-surface</code></div><div class="w-36"><div class="h-10 border border-[var(--color-border)]" style="background: var(--color-surface-muted);"></div><code class="mt-1 block break-all text-[10px] text-[color:var(--color-text-muted)]">--color-surface-muted</code></div><div class="w-36"><div class="h-10 border border-[var(--color-border)]" style="background: var(--color-surface-variant);"></div><code class="mt-1 block break-all text-[10px] text-[color:var(--color-text-muted)]">--color-surface-variant</code></div><div class="w-36"><div class="h-10 border border-[var(--color-border)]" style="background: var(--color-text-primary);"></div><code class="mt-1 block break-all text-[10px] text-[color:var(--color-text-muted)]">--color-text-primary</code></div><div class="w-36"><div class="h-10 border border-[var(--color-border)]" style="background: var(--color-text-secondary);"></div><code class="mt-1 block break-all text-[10px] text-[color:var(--color-text-muted)]">--color-text-secondary</code></div><div class="w-36"><div class="h-10 border border-[var(--color-border)]" style="background: var(--color-text-muted);"></div><code class="mt-1 block break-all text-[10px] text-[color:var(--color-text-muted)]">--color-text-muted</code></div><div class="w-36"><div class="h-10 border border-[var(--color-border)]" style="background: var(--color-border);"></div><code class="mt-1 block break-all text-[10px] text-[color:var(--color-text-muted)]">--color-border</code></div><div class="w-36"><div class="h-10 border border-[var(--color-border)]" style="background: var(--color-border-strong);"></div><code class="mt-1 block break-all text-[10px] text-[color:var(--color-text-muted)]">--color-border-strong</code></div><div class="w-36"><div class="h-10 border border-[var(--color-border)]" style="background: var(--color-accent);"></div><code class="mt-1 block break-all text-[10px] text-[color:var(--color-text-muted)]">--color-accent</code></div><div class="w-36"><div class="h-10 border border-[var(--color-border)]" style="background: var(--color-accent-contrast);"></div><code class="mt-1 block break-all text-[10px] text-[color:var(--color-text-muted)]">--color-accent-contrast</code></div><div class="w-36"><div class="h-10 border border-[var(--color-border)]" style="background: var(--color-success);"></div><code class="mt-1 block break-all text-[10px] text-[color:var(--color-text-muted)]">--color-success</code></div><div class="w-36"><div class="h-10 border border-[var(--color-border)]" style="background: var(--color-warning);"></div><code class="mt-1 block break-all text-[10px] text-[color:var(--color-text-muted)]">--color-warning</code></div><div class="w-36"><div class="h-10 border border-[var(--color-border)]" style="background: var(--color-error);"></div><code class="mt-1 block break-all text-[10px] text-[color:var(--color-text-muted)]">--color-error</code></div></div></section><section class="ui-section p-4 sm:p-6"><h2 class="ui-page-title !text-base">Button</h2><p class="mt-1 mb-4 text-xs text-[color:var(--color-text-muted)]">One primary action per screen. Variants: default, primary, ghost, danger.</p><div class="mt-4 flex flex-wrap items-start gap-3"><button type="button" class="ui-btn disabled:opacity-50">Default</button><button type="button" class="ui-btn-primary disabled:opacity-50">Primary</button><button type="button" class="ui-btn-ghost disabled:opacity-50">Ghost</button><button type="button" class="ui-btn-danger disabled:opacity-50">Danger</button><button type="button" class="ui-btn disabled:opacity-50" disabled="">Disabled</button></div></section><section class="ui-section p-4 sm:p-6"><h2 class="ui-page-title !text-base">IconButton</h2><p class="mt-1 mb-4 text-xs text-[color:var(--color-text-muted)]">Bare icon. Hover is the accent colour, never a background. \`label\` is required.</p><div class="mt-4 flex flex-wrap items-start gap-3"><button type="button" aria-label="Search" title="Search" class="ui-icon-btn"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search h-4 w-4" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg></button><button type="button" aria-label="Delete" title="Delete" class="ui-icon-btn"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash lucide-trash-2 h-4 w-4" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button><button type="button" aria-label="Disabled" title="Disabled" class="ui-icon-btn" disabled=""><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search h-4 w-4" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg></button></div></section><section class="ui-section p-4 sm:p-6"><h2 class="ui-page-title !text-base">Chip</h2><p class="mt-1 mb-4 text-xs text-[color:var(--color-text-muted)]">Selected is a tonal step with an accent rule, not a lime fill.</p><div class="mt-4 flex flex-wrap items-start gap-3"><button type="button" aria-pressed="true" class="ui-chip-btn !w-auto">all</button><button type="button" aria-pressed="false" class="ui-chip-btn !w-auto">unread</button><button type="button" aria-pressed="false" class="ui-chip-btn !w-auto">finished</button></div></section><section class="ui-section p-4 sm:p-6"><h2 class="ui-page-title !text-base">TextInput</h2><p class="mt-1 mb-4 text-xs text-[color:var(--color-text-muted)]">The border clears 3:1 contrast on purpose. Always give it a label.</p><div class="mt-4 flex flex-wrap items-start gap-3"><div class="w-64"><input class="ui-input" aria-label="Title" placeholder="Title" type="text"></div><div class="w-64"><input class="ui-input" aria-label="Disabled" placeholder="Disabled" disabled="" type="text"></div></div></section><section class="ui-section p-4 sm:p-6"><h2 class="ui-page-title !text-base">Dropdown</h2><div class="mt-4 flex flex-wrap items-start gap-3"><div class="w-48"><button type="button" class="flex items-center justify-between gap-2 w-full cursor-pointer focus-visible:outline-2 focus-visible:outline-[color:var(--color-focus-ring)] focus-visible:outline-offset-2 text-[color:var(--color-text-primary)] transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed px-4 py-2 text-sm bg-[var(--color-surface)] border-2 border-[var(--color-border)]" id="x" aria-haspopup="menu" aria-expanded="false" data-state="closed"><span class="truncate">Title</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down w-4 h-4 text-[color:var(--color-text-muted)] flex-shrink-0 transition-transform duration-200 data-[state=open]:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></div></div></section><section class="ui-section p-4 sm:p-6"><h2 class="ui-page-title !text-base">Select</h2><p class="mt-1 mb-4 text-xs text-[color:var(--color-text-muted)]">A native picker with the input border; keep the platform list.</p><div class="mt-4 flex flex-wrap items-start gap-3"><div class="w-56"><select class="ui-input" aria-label="Format"><option value="epub">EPUB</option><option value="pdf">PDF</option><option value="cbz">Comic (CBZ)</option></select></div></div></section><section class="ui-section p-4 sm:p-6"><h2 class="ui-page-title !text-base">Checkbox and Switch</h2><p class="mt-1 mb-4 text-xs text-[color:var(--color-text-muted)]">Both are named by their label; neither relies on colour alone.</p><div class="mt-4 flex flex-wrap items-start gap-3"><label for="x" class="inline-flex cursor-pointer items-center gap-2 text-sm text-[color:var(--color-text-secondary)]"><input id="x" class="h-4 w-4 accent-[var(--color-accent)]" type="checkbox" checked="">Keep unread articles</label><label for="x" class="inline-flex cursor-pointer items-center gap-2 text-sm text-[color:var(--color-text-secondary)]"><input id="x" class="h-4 w-4 accent-[var(--color-accent)]" disabled="" type="checkbox">Disabled</label><button id="x" type="button" role="switch" aria-checked="false" aria-label="Auto sync" class="relative inline-flex h-6 w-11 shrink-0 items-center border transition-colors disabled:opacity-50 border-[var(--color-border-strong)] bg-[var(--color-surface-muted)]"><span aria-hidden="true" class="block h-4 w-4 transition-transform translate-x-1 bg-[var(--color-text-muted)]"></span></button><button id="x" type="button" role="switch" aria-checked="false" aria-label="Disabled" disabled="" class="relative inline-flex h-6 w-11 shrink-0 items-center border transition-colors disabled:opacity-50 border-[var(--color-border-strong)] bg-[var(--color-surface-muted)]"><span aria-hidden="true" class="block h-4 w-4 transition-transform translate-x-1 bg-[var(--color-text-muted)]"></span></button></div></section><section class="ui-section p-4 sm:p-6"><h2 class="ui-page-title !text-base">Tabs</h2><p class="mt-1 mb-4 text-xs text-[color:var(--color-text-muted)]">ARIA tab pattern: arrow keys, Home and End move between tabs.</p><div class="mt-4 flex flex-wrap items-start gap-3"><div class="w-full"><div role="tablist" aria-label="Workbench sections" class="flex items-center gap-1"><button id="x" type="button" role="tab" aria-selected="true" aria-controls="x" tabindex="0" class="ui-tab-btn ui-selected">Highlights<span class="ml-1.5 font-mono text-[10px]">12</span></button><button id="x" type="button" role="tab" aria-selected="false" aria-controls="x" tabindex="-1" class="ui-tab-btn">Notes<span class="ml-1.5 font-mono text-[10px]">3</span></button><button id="x" type="button" role="tab" aria-selected="false" aria-controls="x" tabindex="-1" class="ui-tab-btn">Words</button></div><div role="tabpanel" id="x" aria-labelledby="x"><p class="pt-3 text-sm text-[color:var(--color-text-secondary)]">Highlights panel</p></div><div role="tabpanel" id="x" aria-labelledby="x" hidden=""><p class="pt-3 text-sm text-[color:var(--color-text-secondary)]">Notes panel</p></div><div role="tabpanel" id="x" aria-labelledby="x" hidden=""><p class="pt-3 text-sm text-[color:var(--color-text-secondary)]">Words panel</p></div></div></div></section><section class="ui-section p-4 sm:p-6"><h2 class="ui-page-title !text-base">Card</h2><p class="mt-1 mb-4 text-xs text-[color:var(--color-text-muted)]">The one shared framed container (the ui-section class).</p><div class="mt-4 flex flex-wrap items-start gap-3"><div class="ui-section p-4 text-sm">Section card</div><div class="p-4 text-sm text-[color:var(--color-text-secondary)]">Plain group</div></div></section><section class="ui-section p-4 sm:p-6"><h2 class="ui-page-title !text-base">Dialogs</h2><div class="mt-4 flex flex-wrap items-start gap-3"><button type="button" class="ui-btn disabled:opacity-50">Modal</button><button type="button" class="ui-btn disabled:opacity-50">ConfirmDialog</button><button type="button" class="ui-btn disabled:opacity-50">AlertDialog</button></div></section><section class="ui-section p-4 sm:p-6"><h2 class="ui-page-title !text-base">Spinner</h2><div class="mt-4 flex flex-wrap items-start gap-3"><span role="status" aria-label="Loading..." class="inline-flex items-center justify-center"><span class="animate-spin h-4 w-4 border-2 border-[var(--color-border)] border-t-[var(--color-accent)]"></span><span class="sr-only">Loading...</span></span><span role="status" aria-label="Loading..." class="inline-flex items-center justify-center"><span class="animate-spin h-8 w-8 border-3 border-[var(--color-border)] border-t-[var(--color-accent)]"></span><span class="sr-only">Loading...</span></span><span role="status" aria-label="Loading..." class="inline-flex items-center justify-center"><span class="animate-spin h-12 w-12 border-3 border-[var(--color-accent)] border-t-transparent"></span><span class="sr-only">Loading...</span></span></div></section><section class="ui-section p-4 sm:p-6"><h2 class="ui-page-title !text-base">TheoremBookCover</h2><p class="mt-1 mb-4 text-xs text-[color:var(--color-text-muted)]">The deterministic fallback cover for books without artwork.</p><div class="mt-4 flex flex-wrap items-start gap-3"><div class="relative aspect-[2/3] overflow-hidden p-3.5 sm:p-4 select-none flex flex-col justify-between bg-[#0e0e11] text-[#f4f4f5] border border-[#27272a] transition-transform duration-200 h-40 w-28"><div class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#27272a] opacity-80"></div><div class="absolute inset-2 border border-[#27272a] pointer-events-none opacity-60"></div><div class="relative z-10 text-center pt-1 min-h-[14px]"><div class="w-6 h-[1px] mx-auto mt-2 bg-[#3f3f46] opacity-40"></div></div><div class="relative z-10 flex flex-col items-center justify-center my-auto py-2 text-center"><h3 class="font-serif text-xs sm:text-sm leading-snug line-clamp-4 px-1 text-white">Children of Dune</h3><div class="w-5 h-[1px] mx-auto my-2 bg-[#3f3f46] opacity-60"></div><p class="text-[9px] sm:text-[10px] truncate max-w-[90%] text-[#a1a1aa]">Frank Herbert</p></div><div class="relative z-10 flex items-center justify-center gap-1.5 pb-1"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0" y="0" width="3" height="24" fill="#71717a" opacity="0.8"></rect><rect x="0" y="10.5" width="15" height="3" fill="#71717a" opacity="0.8"></rect></svg><span class="text-[7px] text-[#71717a] opacity-80">THEOREM</span></div></div><div class="relative aspect-[2/3] overflow-hidden p-3.5 sm:p-4 select-none flex flex-col justify-between bg-[#0e0e11] text-[#f4f4f5] border border-[#27272a] transition-transform duration-200 h-40 w-28"><div class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#27272a] opacity-80"></div><div class="absolute inset-2 border border-[#27272a] pointer-events-none opacity-60"></div><div class="relative z-10 text-center pt-1 min-h-[14px]"><div class="w-6 h-[1px] mx-auto mt-2 bg-[#3f3f46] opacity-40"></div></div><div class="relative z-10 flex flex-col items-center justify-center my-auto py-2 text-center"><h3 class="font-serif text-xs sm:text-sm leading-snug line-clamp-4 px-1 text-white">A very long book title that has to truncate somewhere</h3><div class="w-5 h-[1px] mx-auto my-2 bg-[#3f3f46] opacity-60"></div><p class="text-[9px] sm:text-[10px] truncate max-w-[90%] text-[#a1a1aa]">Public Domain</p></div><div class="relative z-10 flex items-center justify-center gap-1.5 pb-1"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0" y="0" width="3" height="24" fill="#71717a" opacity="0.8"></rect><rect x="0" y="10.5" width="15" height="3" fill="#71717a" opacity="0.8"></rect></svg><span class="text-[7px] text-[#71717a] opacity-80">THEOREM</span></div></div></div></section></div>"`;
